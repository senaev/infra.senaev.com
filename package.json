{
  "name": "infra-senaev-com",
  "private": true,
  "description": "Root manifest. Owns the shared toolchain only; every package keeps its own dependencies and lockfile.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p senaev-utils --noEmit && tsc -p cluster-helper --noEmit && tsc -p media-server-helper --noEmit && tsc -p obsidian-sync --noEmit && tsc -p vpn-subscription --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "simple-checks": "concurrently --prefix-colors auto --timings npm:lint npm:typecheck npm:test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@stylistic/eslint-plugin": "2.12.1",
    "@types/node": "25.4.0",
    "concurrently": "^10.0.5",
    "eslint": "9.17.0",
    "eslint-plugin-import-x": "^4.6.1",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "eslint-plugin-react": "7.37.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^14.0.0",
    "jsdom": "^27.0.0",
    "lefthook": "^1.10.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.32.0",
    "vitest": "^3.2.0"
  }
}
