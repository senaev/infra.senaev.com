{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "llmWorkspaces"
  ],
  "properties": {
    "llmWorkspaces": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,29}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enabled",
          "agent",
          "instructionsPath",
          "codeStorageSize",
          "vps",
          "traefik"
        ],
        "allOf": [
          {
            "if": {
              "required": ["opencode"],
              "properties": { "opencode": { "properties": { "enabled": { "const": true } } } }
            },
            "then": { "required": ["git", "telegram"] }
          },
          {
            "if": {
              "required": ["claudeCode"],
              "properties": { "claudeCode": { "properties": { "enabled": { "const": true } } } }
            },
            "then": { "required": ["git"] }
          },
          {
            "if": {
              "required": ["codex"],
              "properties": { "codex": { "properties": { "enabled": { "const": true } } } }
            },
            "then": { "required": ["git"] }
          },
          {
            "if": {
              "required": ["codeTools"],
              "properties": { "codeTools": { "properties": { "enabled": { "const": true } } } }
            },
            "then": {
              "required": ["opencode"],
              "properties": { "opencode": { "properties": { "enabled": { "const": true } } } }
            }
          }
        ],
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Explicitly enable or disable this workspace; disabling retains existing PVCs."
          },
          "instructionsPath": {
            "type": "string",
            "minLength": 1
          },
          "projectsStorageSize": {
            "type": "string",
            "minLength": 1
          },
          "codeStorageSize": {
            "type": "string",
            "minLength": 1
          },
          "agent": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "defaultModel",
              "connectors",
              "speechToText"
            ],
            "properties": {
              "defaultModel": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "provider",
                  "id"
                ],
                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "connectors": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "baseUrl",
                    "secretKey"
                  ],
                  "properties": {
                    "baseUrl": {
                      "type": "string",
                      "minLength": 1
                    },
                    "secretKey": {
                      "description": "The Vault key name. The pod gets it as an env variable with the same name",
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "speechToText": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "baseUrl",
                  "model",
                  "secretKey"
                ],
                "properties": {
                  "baseUrl": {
                    "type": "string",
                    "minLength": 1
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "secretKey": {
                    "description": "The Vault key name",
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "git": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "email",
              "githubToken",
              "sshPrivateKey"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "email": {
                "type": "string",
                "minLength": 1
              },
              "githubToken": {
                "type": "string",
                "minLength": 1
              },
              "sshPrivateKey": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "telegram": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "token",
              "allowedUser"
            ],
            "properties": {
              "token": {
                "type": "string",
                "minLength": 1
              },
              "allowedUser": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "vps": {
            "type": "string",
            "minLength": 1
          },
          "traefik": {
            "type": "string",
            "minLength": 1
          },
          "opencode": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "enabled",
              "hostname",
              "mcp",
              "secrets"
            ],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "hostname": {
                "type": "string",
                "minLength": 1
              },
              "mcp": {
                "description": "OpenCode remote MCP servers, by name, in the OpenCode config format. The template adds type remote and the OAuth redirect_uri and callback_port; set oauth.client_id for a server that needs a static client id",
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": ["url"],
                  "properties": {
                    "url": { "type": "string", "minLength": 1 },
                    "oauth": { "type": "object" }
                  }
                }
              },
              "secrets": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "opencodePassword"
                ],
                "properties": {
                  "opencodePassword": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "ompWeb": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "enabled",
              "hostname",
              "storageSize",
              "secrets"
            ],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "hostname": {
                "type": "string",
                "minLength": 1
              },
              "storageSize": {
                "type": "string",
                "minLength": 1
              },
              "secrets": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ompHtpasswd"
                ],
                "properties": {
                  "ompHtpasswd": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "claudeCode": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "enabled",
              "model",
              "mcp",
              "telegram"
            ],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "model": {
                "description": "The model of new sessions: an alias such as sonnet, or a full model name",
                "type": "string",
                "minLength": 1
              },
              "mcp": {
                "description": "Claude Code HTTP MCP servers, by name. start.sh writes them into the user config; the telegram-login container logs in to them",
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["url"],
                  "properties": {
                    "url": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "telegram": {
                "description": "The bot that sends the login link and the expiry warning, and takes the login code",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "token",
                  "user"
                ],
                "properties": {
                  "token": {
                    "description": "The Vault key of the bot token",
                    "type": "string",
                    "minLength": 1
                  },
                  "user": {
                    "description": "The Vault key of the Telegram user id. It is also the id of the private chat, the only chat the bot answers in",
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "codex": {
            "type": "object",
            "additionalProperties": false,
            "required": ["enabled", "remoteControl"],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "remoteControl": {
                "description": "Run codex remote-control for the ChatGPT app; when false, the container only keeps the login",
                "type": "boolean"
              }
            }
          },
          "codeTools": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
