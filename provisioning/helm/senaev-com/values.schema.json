{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "codingAgentInstances"
  ],
  "properties": {
    "codingAgentInstances": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,29}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "owner",
          "instructionsPath",
          "secrets",
          "ingress",
          "opencode",
          "ompWeb",
          "codeTools"
        ],
        "properties": {
          "owner": {
            "type": "object",
            "required": [
              "name",
              "email"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "email": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "instructionsPath": {
            "type": "string",
            "minLength": 1
          },
          "agentConfigFile": {
            "type": "string",
            "minLength": 1
          },
          "agent": {
            "type": "object",
            "required": [
              "mcp",
              "defaultModel",
              "connectors",
              "speechToText"
            ],
            "properties": {
              "mcp": {
                "type": "object"
              },
              "defaultModel": {
                "type": "object",
                "required": [
                  "provider",
                  "id"
                ],
                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "connectors": {
                "type": "object"
              },
              "speechToText": {
                "type": "object",
                "required": [
                  "baseUrl",
                  "model",
                  "apiKeyEnv"
                ],
                "properties": {
                  "baseUrl": {
                    "type": "string",
                    "minLength": 1
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "apiKeyEnv": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "secrets": {
            "type": "object",
            "required": [
              "name",
              "storeName",
              "storeKind",
              "vaultPath",
              "opencodePassword",
              "ompHtpasswd",
              "githubToken",
              "sshPrivateKey",
              "telegramToken",
              "telegramAllowedUser"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "storeName": {
                "type": "string",
                "minLength": 1
              },
              "storeKind": {
                "type": "string",
                "minLength": 1
              },
              "vaultPath": {
                "type": "string",
                "minLength": 1
              },
              "opencodePassword": {
                "type": "string",
                "minLength": 1
              },
              "ompHtpasswd": {
                "type": "string",
                "minLength": 1
              },
              "githubToken": {
                "type": "string",
                "minLength": 1
              },
              "sshPrivateKey": {
                "type": "string",
                "minLength": 1
              },
              "telegramToken": {
                "type": "string",
                "minLength": 1
              },
              "telegramAllowedUser": {
                "type": "string",
                "minLength": 1
              },
              "codeToolsToken": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "ingress": {
            "type": "object",
            "required": [
              "className",
              "traefikDeployment",
              "namespace",
              "entrypoints",
              "certResolver"
            ],
            "properties": {
              "className": {
                "type": "string",
                "minLength": 1
              },
              "traefikDeployment": {
                "type": "string",
                "minLength": 1
              },
              "namespace": {
                "type": "string",
                "minLength": 1
              },
              "entrypoints": {
                "type": "string",
                "minLength": 1
              },
              "certResolver": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "opencode": {
            "type": "object",
            "required": [
              "enabled",
              "vps",
              "hostname",
              "dataPath",
              "projectsStorageSize",
              "mcpOAuth"
            ],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "vps": {
                "type": "string",
                "minLength": 1
              },
              "hostname": {
                "type": "string",
                "minLength": 1
              },
              "dataPath": {
                "type": "string",
                "pattern": "^/[^/]"
              },
              "projectsStorageSize": {
                "type": "string",
                "minLength": 1
              },
              "mcpOAuth": {
                "type": "object",
                "required": [
                  "hostname",
                  "callbackPort"
                ],
                "properties": {
                  "hostname": {
                    "type": "string",
                    "minLength": 1
                  },
                  "callbackPort": {
                    "type": "integer",
                    "minimum": 1024,
                    "maximum": 65535
                  }
                }
              }
            }
          },
          "ompWeb": {
            "type": "object",
            "required": [
              "enabled",
              "hostname",
              "storageSize"
            ],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "hostname": {
                "type": "string",
                "minLength": 1
              },
              "storageSize": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "codeTools": {
            "type": "object",
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "type": "boolean"
              }
            }
          }
        },
        "anyOf": [
          {
            "required": [
              "agentConfigFile"
            ]
          },
          {
            "required": [
              "agent"
            ]
          }
        ]
      }
    }
  }
}
