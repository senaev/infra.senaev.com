# Every service image is built with the repository root as its context, so that
# the `file:../senaev-utils` link can be resolved. Keep the context small.
**/node_modules
**/npm-debug.log
**/dist
**/.next
**/*.tsbuildinfo
nextjs-app/.env
nextjs-app/.env*.local
nextjs-app/next-env.d.ts
.git
.gitignore
.github
.vscode
issues
provisioning
scripts
**/Dockerfile
.dockerignore

# Next.js serves this tree verbatim, including vendored bundles under dist/.
!nextjs-app/public/**
